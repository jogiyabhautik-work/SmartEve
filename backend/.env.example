# =========================================================
# SmartEve Backend Configuration Environment Variables
# =========================================================

PORT=4000
NODE_ENV=development

# 1. Neon.tech PostgreSQL Database
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-cool-hall-a1b2c3d4.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Firebase Admin SDK (Authentication & FCM Push Notifications)
FIREBASE_ADMIN_PROJECT_ID=smarteve-prod
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smarteve-prod.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. Cloudinary Image CDN (Speaker Headshots & Event Visuals)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. Quad-Tier AI Providers (Fail-Safe Cascade)
# Tier 1: Google Gemini (Primary creative & contextual model)
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 2: Groq (Ultra-low latency Llama 3.3 70B inference)
GROQ_API_KEY=your_groq_api_key_here

# Tier 3: Nvidia NIM (Enterprise DGX microservices)
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here

# Tier 4: OpenRouter (Universal multi-model gateway)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
